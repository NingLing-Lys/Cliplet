<Application x:Class="Cliplet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cliplet">
    <Application.Resources>
        <local:PathToImageConverter x:Key="PathToImage"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisible"/>
        <local:EmptyToVisibilityConverter x:Key="EmptyToVisible"/>
        <local:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisible"/>
        <local:SourceIconConverter x:Key="SourceIcon"/>
        <local:HasSourceIconConverter x:Key="HasSourceIcon"/>
        <local:NoSourceIconConverter x:Key="NoSourceIcon"/>

        <!-- Clean light panel (reference style) -->
        <SolidColorBrush x:Key="WindowBg" Color="#00FFFFFF"/>
        <SolidColorBrush x:Key="GlassFill" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="GlassStroke" Color="#1A000000"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#8E8E93"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#1A3C3C43"/>
        <SolidColorBrush x:Key="ItemHover" Color="#0F000000"/>
        <SolidColorBrush x:Key="ItemSelected" Color="#007AFF"/>
        <SolidColorBrush x:Key="SearchFill" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ChipFill" Color="#EEEFF1"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>
        <Color x:Key="ShadowColor">#40000000</Color>
        <Color x:Key="HighlightTop">#FFFFFFFF</Color>
        <Color x:Key="HighlightMid">#FFFFFFFF</Color>
        <Color x:Key="HighlightBot">#FFFFFFFF</Color>
    </Application.Resources>
</Application>
