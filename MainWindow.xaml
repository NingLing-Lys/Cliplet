<Window x:Class="Cliplet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cliplet"
        Width="420"
        Height="560"
        MinWidth="360"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ItemHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ItemHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,10,8,0" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <TextBlock Text="Cliplet" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                <Button Content="×" HorizontalAlignment="Right" FontSize="16" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="关闭"/>
            </Grid>

            <Border Grid.Row="1" Margin="12,10,12,8" Padding="10,7" CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="14"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"/>
                    <TextBlock Text="搜索文本、文件或来源"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryBrush}"
                               Visibility="{Binding Query, Converter={StaticResource EmptyToVisible}}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Margin="12,0,12,8"
                        Padding="8"
                        CornerRadius="8"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        Visibility="{Binding SelectedItem.PreviewPath, ElementName=ClipList, Converter={StaticResource NonEmptyToVisible}}">
                    <Image MaxHeight="180"
                           Stretch="Uniform"
                           Source="{Binding SelectedItem.PreviewPath, ElementName=ClipList, Converter={StaticResource PathToImage}, ConverterParameter=640}"/>
                </Border>
                <Border x:Name="TextTools"
                        Grid.Row="1"
                        Margin="12,0,12,8"
                        Padding="8"
                        CornerRadius="8"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <FlowDocumentScrollViewer x:Name="FormulaView"
                                                  MaxHeight="230"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  IsToolBarVisible="False"
                                                  Focusable="False"
                                                  IsTabStop="False"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="OptimizeButton"
                                    Content="优化提示词"
                                    Style="{StaticResource ChipButton}"
                                    Click="Optimize_Click"
                                    ToolTip="整理成更好发给大模型的提示词"/>
                            <Button x:Name="FormulaImageButton"
                                    Content="复制公式图"
                                    Style="{StaticResource ChipButton}"
                                    Click="FormulaImage_Click"
                                    Visibility="Collapsed"
                                    ToolTip="把公式排成一张图，方便贴到微信"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2">
                <ListBox x:Name="ClipList"
                         ItemsSource="{Binding Visible}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True"
                         PreviewMouseLeftButtonUp="ClipList_PreviewMouseLeftButtonUp"
                         MouseDoubleClick="ClipList_MouseDoubleClick"
                         SelectionChanged="ClipList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="Margin" Value="8,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ItemHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ItemSelected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="36" Height="36">
                                    <Border Background="{DynamicResource ItemHover}" CornerRadius="7"/>
                                    <TextBlock Text="{Binding KindMark}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" FontSize="13"/>
                                    <Image Source="{Binding PreviewPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry RadiusX="7" RadiusY="7" Rect="0,0,36,36"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="删除" FontSize="12" Click="Delete_Click" ToolTip="删除这条记录" Margin="0,0,2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="{Binding PinGlyph}" Click="Pin_Click" ToolTip="置顶或取消置顶">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding EmptyText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="24"
                           TextAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryBrush}"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}"/>
                </Grid>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8,22,10">
                <Grid>
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
                    <TextBlock Text="{Binding HotkeyLabel, StringFormat={}{0} 开关}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource SecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
